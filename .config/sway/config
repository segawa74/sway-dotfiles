# Default fedora config for sway
include /etc/sway/config

# --Segawa74-Settings--
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    pointer_accel 0
    drag_lock disabled
}

input "type:keyboard" {
    xkb_layout jp
}

# Lid event-driven display toggling
# 1. Turn off the internal display (eDP-1) when the lid is closed
bindswitch --reload lid:on output eDP-1 disable
# 2. Turn on the internal display (eDP-1) when the lid is opened
bindswitch --reload lid:off output eDP-1 enable

exec fcitx5 -d
