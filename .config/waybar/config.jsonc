{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "custom/cava", "mpris", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": [ "pulseaudio", "backlight", "cpu", "memory", "temperature", "battery", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "sway/window": {
        "format": "{}",
        "max-length": 50,
        "rewrite": {
            "(.*) - Mozilla Firefox": "🦊 $1",
            "(.*) - Alacritty": "💻 $1"
        }
    },
    "cpu": {
        "format": "  {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "  {}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "   {essid}",
        "format-ethernet": "󰈀  eth",
        "format-disconnected": "⚠  Disconnected",
        "tooltip-format-wifi": "{signalStrength}%"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "🔇 ",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "clock": {
        "format": "  {:%Y-%m-%d %H:%M}",
        "tooltip": true,
        "tooltip-format": "{:%Y-%m-%d %H:%M}"
    },
    "custom/cava": {
        "exec": "cava -p ~/.config/cava/config | sed -u 's/;//g;s/0/ /g;s/1/▂/g;s/2/▃/g;s/3/▄/g;s/4/▅/g;s/5/▆/g;s/6/▇/g;s/7/█/g'",
        "format": "♫ {}"
    },
    "mpris": {
        "format": " {artist} - {title}",
        "format-paused": "  {artist} - {title}",
        "max-length": 30,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },
    "backlight": {
        "device": "intel_backlight", // ThinkPad X13に合わせるための指定
        "format": "{icon} {percent}%",
        "format-icons": [""]
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", "", "", ""]
    },

}
